#!/usr/bin/env python3
"""OhmTabs native autoload management (docs/AUTOLOAD.md).

    ohmtabs-autoload status  [--state-dir DIR] [--hypr-config FILE] [--json]
    ohmtabs-autoload enable  [--state-dir DIR] [--hypr-config FILE]
    ohmtabs-autoload disable [--state-dir DIR] [--hypr-config FILE]
    ohmtabs-autoload retry   [--state-dir DIR]
    ohmtabs-autoload arm     [--state-dir DIR]        # create the 'enabled' marker only
    ohmtabs-autoload disarm  [--state-dir DIR]        # remove it (config hook stays, declares nothing)

`enable` writes one guarded line into the Hyprland Lua config (with a timestamped
backup) and creates the 'enabled' marker. It never reloads the compositor: the
operator decides when the plugin is first loaded (`hyprctl reload`, or the next
login). `disable` removes the line and the marker. `retry` clears a recorded
failed start so the next evaluation declares the plugin again.
"""
import argparse, json, os, re, sys, tempfile, time

BEGIN = "-- BEGIN tech.loopedmatrix.ohmtabs autoload"
END = "-- END tech.loopedmatrix.ohmtabs autoload"
HOOK = (
    BEGIN + "\n"
    "-- Managed by `ohmtabs autoload enable|disable`. Loads OhmTabs's native window\n"
    "-- controls through the plugin's own guarded loader (docs/AUTOLOAD.md).\n"
    'pcall(dofile, (os.getenv("HOME") or "") .. "/.config/omarchy/plugins/tech.loopedmatrix.ohmtabs/native/autoload.lua")\n'
    + END + "\n"
)


def default_state_dir():
    return os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "ohmtabs")


def default_hypr_config():
    return os.path.expanduser("~/.config/hypr/hyprland.lua")


def read_line(path):
    try:
        with open(path) as f:
            return f.readline().strip()
    except OSError:
        return None


def status(state_dir, hypr_config):
    d = os.path.join(state_dir, "autoload")
    hooked = False
    try:
        with open(hypr_config) as f:
            text = f.read()
        # Either the helper's own marked block, or a hand-written direct hook
        # (pcall(dofile, .../native/autoload.lua)) - both are installed.
        hooked = BEGIN in text or ("autoload.lua" in text and "ohmtabs" in text)
    except OSError:
        pass
    last_attempt = read_line(os.path.join(d, "last-attempt"))
    last_ok = read_line(os.path.join(d, "last-ok"))
    skipped = read_line(os.path.join(d, "skipped"))
    current = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    armed = os.path.exists(os.path.join(d, "enabled"))
    if not hooked:
        state = "not-installed"
    elif not armed:
        state = "disarmed"
    elif last_attempt and last_attempt != current and last_attempt != last_ok:
        state = "skipped-after-failed-start"
    elif last_attempt == current and current:
        state = "active-this-session" if last_ok == current else "active-this-session-unconfirmed"
    else:
        state = "armed"
    return {
        "schema": 1,
        "state": state,
        "hookInstalled": hooked,
        "armed": armed,
        "hyprConfig": hypr_config,
        "stateDir": d,
        "lastAttempt": last_attempt,
        "lastOk": last_ok,
        "skipped": skipped,
        "currentInstance": current,
    }


def ensure_dir(d):
    os.makedirs(d, mode=0o700, exist_ok=True)


def arm(state_dir):
    d = os.path.join(state_dir, "autoload")
    ensure_dir(d)
    with open(os.path.join(d, "enabled"), "w") as f:
        f.write(str(int(time.time())) + "\n")


def disarm(state_dir):
    p = os.path.join(state_dir, "autoload", "enabled")
    try:
        os.unlink(p)
    except FileNotFoundError:
        pass


def retry(state_dir):
    d = os.path.join(state_dir, "autoload")
    for name in ("last-attempt", "skipped"):
        try:
            os.unlink(os.path.join(d, name))
        except FileNotFoundError:
            pass


def _atomic_backup(content_bytes, base_path):
    """Write an exclusive, collision-safe backup next to *base_path*.

    Uses ``mkstemp`` so the file is created exclusively (no symlink
    following) and a unique name is guaranteed.  Returns the absolute
    path of the written backup.
    """
    backup_dir = os.path.dirname(base_path)
    target_name = os.path.basename(base_path)
    fd, path = tempfile.mkstemp(
        prefix="ohmtabs-" + target_name + "-",
        suffix=".bak",
        dir=backup_dir,
    )
    try:
        written = 0
        total = len(content_bytes)
        while written < total:
            n = os.write(fd, content_bytes[written:])
            if n <= 0:
                raise OSError("short write: wrote %d of %d bytes" % (written, total))
            written += n
        if written != total:
            raise OSError("incomplete write: %d of %d bytes" % (written, total))
        os.close(fd)
        os.chmod(path, 0o644)
        return path
    except BaseException:
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.unlink(path)
        except OSError:
            pass
        raise


def _atomic_replace(content_bytes, target_path, mode=0o644):
    """Write *content_bytes* to a brand-new temp file in the same directory
    as *target_path*, then ``os.replace`` it onto *target_path*.

    The temp file is created exclusively via ``mkstemp``, so an existing
    symlink at the predictable ``.tmp`` path is never followed or truncated.
    If anything fails before the replace, the temp file is cleaned up.
    """
    target_dir = os.path.dirname(target_path) or "."
    fd, tmp = tempfile.mkstemp(
        prefix="ohmtabs-" + os.path.basename(target_path) + "-",
        suffix=".tmp",
        dir=target_dir,
    )
    try:
        written = 0
        total = len(content_bytes)
        while written < total:
            n = os.write(fd, content_bytes[written:])
            if n <= 0:
                raise OSError("short write: wrote %d of %d bytes" % (written, total))
            written += n
        if written != total:
            raise OSError("incomplete write: %d of %d bytes" % (written, total))
        os.close(fd)
        os.chmod(tmp, mode)
        os.replace(tmp, target_path)
    except BaseException:
        try:
            os.close(fd)
        except OSError:
            pass
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def enable(state_dir, hypr_config):
    try:
        with open(hypr_config) as f:
            text = f.read()
    except FileNotFoundError:
        sys.exit("ohmtabs-autoload: %s does not exist; OhmTabs autoload needs Hyprland's Lua config" % hypr_config)
    if BEGIN in text:
        arm(state_dir)
        return "already-installed"
    backup = _atomic_backup(text.encode("utf-8"), hypr_config)
    if not text.endswith("\n"):
        text += "\n"
    text += "\n" + HOOK
    _atomic_replace(text.encode("utf-8"), hypr_config)
    arm(state_dir)
    return "installed (backup: %s)" % backup


def disable(state_dir, hypr_config):
    disarm(state_dir)
    try:
        with open(hypr_config) as f:
            text = f.read()
    except FileNotFoundError:
        return "no config"
    if BEGIN not in text:
        return "not-installed"
    new = re.sub(r"\n?" + re.escape(BEGIN) + r".*?" + re.escape(END) + r"\n", "", text, count=1, flags=re.S)
    backup = _atomic_backup(text.encode("utf-8"), hypr_config)
    _atomic_replace(new.encode("utf-8"), hypr_config)
    return "removed (backup: %s)" % backup


def main():
    ap = argparse.ArgumentParser(description="OhmTabs native autoload")
    ap.add_argument("command", choices=("status", "enable", "disable", "retry", "arm", "disarm"))
    ap.add_argument("--state-dir", default=default_state_dir())
    ap.add_argument("--hypr-config", default=default_hypr_config())
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if a.command == "status":
        s = status(a.state_dir, a.hypr_config)
        if a.json:
            print(json.dumps(s, indent=2, sort_keys=True))
        else:
            print("autoload        %s" % s["state"])
            if s["skipped"]:
                print("skipped start   %s (clear with: ohmtabs autoload retry)" % s["skipped"])
        return
    if a.command == "enable":
        print("autoload hook: %s" % enable(a.state_dir, a.hypr_config))
        print("Nothing was loaded. The plugin loads at the next `hyprctl reload` or login.")
    elif a.command == "disable":
        print("autoload hook: %s" % disable(a.state_dir, a.hypr_config))
    elif a.command == "retry":
        retry(a.state_dir); print("cleared the recorded failed start")
    elif a.command == "arm":
        arm(a.state_dir); print("armed")
    elif a.command == "disarm":
        disarm(a.state_dir); print("disarmed")


if __name__ == "__main__":
    main()
